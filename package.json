{
  "name": "petflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @petflow/web dev",
    "dev:api": "pnpm --filter @petflow/api dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @petflow/api test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:backup": "ts-node --transpile-only scripts/db-backup.ts",
    "db:restore": "ts-node --transpile-only scripts/db-restore.ts",
    "tenant:export": "ts-node --transpile-only scripts/tenant-export.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eslint": "^9.18.0",
    "prisma": "^6.3.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.23.0"
}
