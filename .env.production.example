# ==============================================================================
# PetFlow Production Environment Variables (.env.production)
# ==============================================================================

# Application
NODE_ENV=production
PORT=4000
API_BASE_URL=https://api.petflow.th/api/v1
WEB_APP_URL=https://app.petflow.th

# Database (PostgreSQL)
POSTGRES_USER=petflow_admin
POSTGRES_PASSWORD=generate_strong_password_here
POSTGRES_DB=petflow_production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=prefer

# Redis (BullMQ & Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=generate_strong_redis_password_here

# Authentication & JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=replace_with_64_char_secret_for_access_tokens
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_64_char_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d

# LINE Messaging API (Thai Customer Reminders)
LINE_CHANNEL_ACCESS_TOKEN=your_production_line_channel_access_token
LINE_CHANNEL_SECRET=your_production_line_channel_secret

# Object Storage (S3 / Cloudflare R2 / AWS)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=petflow-prod-media
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_PUBLIC_DOMAIN=https://cdn.petflow.th

# Email Delivery (SendGrid / AWS SES / Resend)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=notifications@petflow.th

# Monitoring & Error Alerting
SENTRY_DSN=https://example@sentry.io/123456
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your-alert-channel
